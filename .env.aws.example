DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
DJANGO_SETTINGS_MODULE=core.settings.production
ALLOWED_HOSTS=api.klyvorek.com
CORS_ALLOWED_ORIGINS=https://www.klyvorek.com,https://klyvorek.com
CSRF_TRUSTED_ORIGINS=https://www.klyvorek.com,https://klyvorek.com,https://api.klyvorek.com
FRONTEND_URL=https://www.klyvorek.com

USE_SQLITE=False
DB_NAME=klyvorek
DB_USER=klyvorek_app
DB_PASSWORD=replace-with-a-long-random-database-password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
GUNICORN_WORKERS=2
CELERY_CONCURRENCY=1

AI_MODE=ollama
LOCAL_MODEL_URL=http://ollama:11434
LOCAL_MODEL_NAME=llama3.2:latest
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_REQUEST_TIMEOUT=300
BEDROCK_MODEL_ID=
BEDROCK_REGION=us-east-1

AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-with-private-media-bucket
AWS_S3_BUCKET_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Klyvorek <no-reply@klyvorek.com>

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
